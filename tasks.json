{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "🚀 Avvia Progetto",
            "type": "shell",
            "command": "${workspaceFolder}\\start.bat",
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "clear": true,
                "focus": true
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "🐳 Docker Compose Up (background)",
