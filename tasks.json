                "focus": true
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "🌱 Seed Database + Apri Compass",
            "type": "shell",
            "command": "python seed_db_galleria.py",
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "clear": true,
                "focus": true
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "🎬 Avvia GUI",
            "type": "shell",
            "command": "python app2.py",
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "clear": true,
                "focus": true
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "⬇️  Stop e Rimuovi Volume (reset completo)",
